@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { display: flex; min-height: 100vh; background-color: #f8f9fa; }
        .sidebar { width: 240px; background: #212529; color: #fff; padding: 1rem; }
        .sidebar a { display: block; color: #adb5bd; padding: 0.5rem 0; text-decoration: none; }
        .sidebar a.active, .sidebar a:hover { color: #fff; }
        .content { flex: 1; padding: 2rem; }
        .summary-bar span { margin-right: 1rem; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h4 class="mb-4">⚙️ Admin</h4>
        <a href="/Admin/Dashboard?tab=users" class="@(ViewBag.Tab=="users"?"active":"")">👥 Users</a>
        <a href="/Admin/Dashboard?tab=orders" class="@(ViewBag.Tab=="orders"?"active":"")">📦 Orders</a>
        <hr />
        <a href="/">← Back to Site</a>
    </div>

    <div class="content">
        @RenderBody()
    </div>
    @RenderSection("Scripts", required: false)
</body>
</html>
