<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Admin Panel</title>
    <link rel="stylesheet" href="~/css/bootstrap.min.css" />
    <style>
        body { display: flex; min-height: 100vh; margin: 0; }
        .sidebar {
            width: 220px; background: #222; color: #fff; padding: 20px;
        }
        .sidebar a {
            color: #ddd; display: block; padding: 8px 10px; text-decoration: none;
        }
        .sidebar a.active, .sidebar a:hover {
            background: #007bff; color: #fff;
        }
        .content { flex-grow: 1; padding: 20px; background: #f8f9fa; }
    </style>
</head>
<body>
    <div class="sidebar">
        <h5>Admin Menu</h5>
        <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Users</a>
        <a asp-area="Admin" asp-controller="Orders" asp-action="Index">Orders</a>
    </div>
    <div class="content">
        @RenderBody()
    </div>
</body>
</html>
