@{
    ViewData["Title"] = "Contact Us";
}

<div class="container mt-5 d-flex flex-wrap gap-4">
    <!-- Left: Contact Form -->
    <div class="flex-fill" style="max-width: 500px;">
        <h2>Contact Us</h2>
        <form asp-action="ContactUs" method="post" class="mt-3">
            <div class="mb-3">
                <label for="reason" class="form-label">Reason</label>
                <select name="reason" id="reason" class="form-select">
                    <option>Problem</option>
                    <option>Suggestion</option>
                    <option>Advertise</option>
                    <option>Other</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="message" class="form-label">Message</label>
                <textarea name="message" id="message" rows="5" class="form-control"></textarea>
            </div>

            <button type="submit" class="btn btn-danger">Submit</button>

            @if (ViewBag.Status != null)
            {
                <p class="text-success mt-3">@ViewBag.Status</p>
            }
        </form>
    </div>
    <!-- Right: Info Box -->
    <div class="flex-fill border border-primary rounded p-3" style="max-width: 400px;">
        <h4 class="text-primary mb-3">Write to us when?</h4>
        <ul>
            <li>You have a complaint or problem.</li>
            <li>You want to suggest a new feature.</li>
            <li>You are interested in advertising opportunities.</li>
        </ul>
    </div>
</div>
