                <!-- ✅ 1. Load Solana Web3 (no require) -->
            <script src="https://unpkg.com/@@solana/web3.js@1.95.3/lib/index.iife.min.js"></script>

                <!-- ✅ 2. Provide a minimal Buffer polyfill (manual, no external dependency) -->
                    <script>
                        // Basic Buffer polyfill compatible with Solana Web3
                        if (typeof window.Buffer === "undefined") {
                            class SimpleBuffer extends Uint8Array {
                                static from(input, encoding) {
                                    if (typeof input === "string") {
                                        if (encoding === "hex") {
                                            const pairs = input.match(/[\da-f]{2}/gi) || [];
                                            return new SimpleBuffer(pairs.map(h => parseInt(h, 16)));
                                        } else {
                                            return new SimpleBuffer(new TextEncoder().encode(input));
                                        }
                                    } else if (input instanceof ArrayBuffer || Array.isArray(input)) {
                                        return new SimpleBuffer(input);
                                    } else if (input instanceof Uint8Array) {
                                        return new SimpleBuffer(input);
                                    } else {
                                        throw new TypeError("Unsupported input for Buffer.from()");
                                    }
                                }
                            }
                            window.Buffer = SimpleBuffer;
                            console.log("✅ Custom Buffer polyfill active");
                        }

                        // Needed by Solana’s internal utils
                        window.global = window;
                        window.process = { env: {} };

                        console.log("✅ Solana + Buffer environment ready");
                    </script>
        <!-- ✅ 2.1. (Optional) Verify environment -->
